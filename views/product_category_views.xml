<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_category_form_company" model="ir.ui.view">
        <field name="name">product.category.form.company</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="before">
                <field name="domex_vinyasa" groups="base.group_system"/>
                <field name="domex_vinyasa_restricted" groups="base.group_system" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="product_category_list_company" model="ir.ui.view">
        <field name="name">product.category.list.company</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_list_view"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="multi_edit">1</attribute>
            </xpath>
            <xpath expr="//field[@name='display_name']" position="after">
                <field name="domex_vinyasa" groups="base.group_system" optional="show"/>
                <field name="domex_vinyasa_restricted" groups="base.group_system" optional="hide" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
