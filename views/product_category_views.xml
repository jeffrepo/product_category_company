<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_category_form_company" model="ir.ui.view">
        <field name="name">product.category.form.company</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="before">
                <field name="company_id" groups="base.group_multi_company"
                       options="{'no_create': True, 'no_open': True}"/>
            </xpath>
        </field>
    </record>

    <record id="product_category_list_company" model="ir.ui.view">
        <field name="name">product.category.list.company</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_list_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='display_name']" position="after">
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
